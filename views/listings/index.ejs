<% layout("./layouts/biolerplate") %>

<style>
  .filters-wrapper {
    display: flex;
    align-items: center;
    gap: 15px;

    width: 100%;
    margin-top: 20px;
}

/* CATEGORY BOX */
#filters {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;

    overflow-x: auto;
    overflow-y: hidden;

    gap: 2rem;

    height: 70px;

    border: 1.3px solid black;
    border-radius: 10px;

    padding: 0 1.5rem;

    flex: 1;
    min-width: 0;

    box-sizing: border-box;
}

/* CATEGORY */
.filter {
    flex-shrink: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    height: 70px;

    color: black;
    text-decoration: none;

    opacity: 0.7;
}

.filter:hover {
    opacity: 1;
}

.filter i {
    font-size: 20px;
}

.filter p {
    margin: 4px 0 0;
    font-size: 12px;
    white-space: nowrap;
}

/* TAX BOX */
.tax-toggle {
    height: 60px;

    display: flex;
    align-items: center;

    gap: 8px;
    
    padding: 0 20px;
    margin-top: 15px;

    border: 1.3px solid black;
    border-radius: 10px;

    flex-shrink: 0;

    white-space: nowrap;
}
.tax-info{
    display: none;
}
/* scrollbar */
#filters::-webkit-scrollbar {
    height: 5px;
}

#filters::-webkit-scrollbar-track {
    background: transparent;
}

#filters::-webkit-scrollbar-thumb {
    border-radius: 10px;
}
</style>

